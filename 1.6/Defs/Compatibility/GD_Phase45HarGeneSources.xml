<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <GeneticDiversity.GD_RaceGeneCompatibilityDef MayRequire="keeptpa.NivarianRace">
    <defName>GD_Compat_Nivarian</defName>
    <label>Nivarian precise gene compatibility</label>
    <description>Defines the native Nivarian xenotypes and keeps Nivarian-specific genes inside the Nivarian race.</description>
    <sourcePackageIds><li>keeptpa.NivarianRace</li></sourcePackageIds>
    <raceDefName>NivarianRace_Pawn</raceDefName>
    <nativeXenotypeDefNames>
      <li>LuminNivarian</li>
      <li>PulsarNivarian</li>
      <li>AegisNivarian</li>
    </nativeXenotypeDefNames>
    <nativeGeneDefNames>
      <li>Nivarian_Lumin_PsychicProgression</li>
      <li>Nivarian_Custos_UnyieldingFocus</li>
      <li>Nivarian_Artifex_Machinery</li>
      <li>Nivarian_Scale_Cover</li>
    </nativeGeneDefNames>
  </GeneticDiversity.GD_RaceGeneCompatibilityDef>

