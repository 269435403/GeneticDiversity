<?xml version="1.0" encoding="utf-8"?>
<ModMetaData>
  <name>Mutation and Hererity</name>
  <author>yyyyy</author>
  <packageId>yyyyy.geneticdiversity</packageId>
  <supportedVersions>
    <li>1.6</li>
  </supportedVersions>
  <description>Mutation and Hererity adds inheritable endogene variation and rare newborn mutations based on genes already present in the current world. Supports vanilla humans, HAR races, configurable intensity, gene blacklists, per-race and per-faction settings, and old-save backfill. Requires Biotech and Harmony.</description>
